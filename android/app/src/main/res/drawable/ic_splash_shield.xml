<?xml version="1.0" encoding="utf-8"?>
<!-- LisKo Branded Red Rounded Shield Logo for Native Launch Splash -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Red Rounded Shield Container (92dp x 92dp with 22dp Rounded Corners) -->
    <item
        android:width="92dp"
        android:height="92dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#DB2B38" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- White Centered Security Shield Icon -->
    <item
        android:width="52dp"
        android:height="52dp"
        android:gravity="center">
        <vector
            android:width="52dp"
            android:height="52dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M12,1L3,5v6c0,5.55 3.84,10.74 9,12c5.16,-1.26 9,-5.45 9,-12V5L12,1z" />
        </vector>
    </item>
</layer-list>
