rules_version = '2';

// ==============================================================================
// Lisko Mobile Safety Application - Cloud Firestore Security Rules
// File: firestore.rules
//
// Role & Architectural Context:
// Defines client-side data validation, schema enforcement, immutability guarantees,
// and ownership enforcement for LisKo Cloud Firestore collections (`trips` & `emergency_events`).
//
// FIREBASE ANONYMOUS AUTHENTICATION ARCHITECTURE:
// LisKo uses Firebase Anonymous Authentication (`request.auth.uid`). Users operate
// accountlessly without login/registration screens, while Firestore enforces document
// ownership via `request.auth.uid == resource.data.userId`.
// ==============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --------------------------------------------------------------------------
    // Helper Validation Functions for `trips`
    // --------------------------------------------------------------------------

    /// Validates allowed status values matching current LisKo application logic.
    function isValidTripStatus(status) {
      return status in [
        'active',
        'timeout_warning',
        'arrived',
        'extended',
        'cancelled',
        'help_requested',
        'expired',
        'Trip Extended'
      ];
    }

    /// Enforces field presence, data types, and schema validity for trip documents.
    function isValidTripSchema(data) {
      // 1. Strict key check: reject unexpected fields
      let allowedKeys = [
        'userId',
        'installationId',
        'destination',
        'estimatedTravelMinutes',
        'startedAt',
        'expectedArrivalAt',
        'completedAt',
        'status',
        'startLocationLat',
        'startLocationLng',
        'wasExtended'
      ];

      return data.keys().hasOnly(allowedKeys)
        // 2. Required fields
        && data.userId is string
        && data.userId == request.auth.uid
        && data.installationId is string
        && data.installationId.size() > 0
        && data.destination is string
        && data.destination.size() > 0
        && data.estimatedTravelMinutes is int
        && data.estimatedTravelMinutes > 0
        && data.startedAt is timestamp
        && data.status is string
        && isValidTripStatus(data.status)
        // 3. Optional fields (validated when present)
        && (!('expectedArrivalAt' in data) || data.expectedArrivalAt is timestamp)
        && (!('completedAt' in data) || data.completedAt is timestamp)
        && (!('startLocationLat' in data) || (data.startLocationLat is number && data.startLocationLat >= -90.0 && data.startLocationLat <= 90.0))
        && (!('startLocationLng' in data) || (data.startLocationLng is number && data.startLocationLng >= -180.0 && data.startLocationLng <= 180.0))
        && (!('wasExtended' in data) || data.wasExtended is bool);
    }

    // --------------------------------------------------------------------------
    // Helper Validation Functions for `emergency_events`
    // --------------------------------------------------------------------------

    /// Enforces field presence, data types, and schema validity for emergency events.
    function isValidEmergencyEventSchema(data) {
      let allowedKeys = [
        'userId',
        'installationId',
        'deviceId',
        'tripId',
        'latitude',
        'longitude',
        'emergencyType',
        'triggeredAt',
        'status'
      ];

      return data.keys().hasOnly(allowedKeys)
        && data.userId is string
        && data.userId == request.auth.uid
        && data.installationId is string
        && data.installationId.size() > 0
        && data.deviceId is string
        && data.tripId is string
        && data.latitude is number
        && data.latitude >= -90.0 && data.latitude <= 90.0
        && data.longitude is number
        && data.longitude >= -180.0 && data.longitude <= 180.0
        && data.emergencyType in ['SOS', 'TIMEOUT_ESCALATION']
        && data.triggeredAt is timestamp
        && data.status == 'active';
    }

    // --------------------------------------------------------------------------
    // `trips` Collection Rules
    // --------------------------------------------------------------------------
    match /trips/{tripId} {
      // Only document owner can read their own trips
      allow read: if isOwner(resource.data.userId);

      // Allow creating new trip documents conforming to schema with matching userId
      allow create: if isAuthenticated() && isValidTripSchema(request.resource.data);

      // Allow updates provided immutability holds, merged result conforms to schema, and owner matches
      allow update: if isOwner(resource.data.userId)
                    && isValidTripSchema(request.resource.data)
                    && request.resource.data.startedAt == resource.data.startedAt
                    && request.resource.data.destination == resource.data.destination
                    && request.resource.data.installationId == resource.data.installationId
                    && request.resource.data.userId == resource.data.userId;

      // Prevent trip record deletions
      allow delete: if false;
    }

    // --------------------------------------------------------------------------
    // `emergency_events` Collection Rules (Immutable Audit Trail)
    // --------------------------------------------------------------------------
    match /emergency_events/{eventId} {
      // Only document owner can read their own emergency events
      allow read: if isOwner(resource.data.userId);

      // Allow creating new emergency event logs conforming to schema with matching userId
      allow create: if isAuthenticated() && isValidEmergencyEventSchema(request.resource.data);

      // Emergency logs are strictly immutable: no updates or deletions allowed
      allow update: if false;
      allow delete: if false;
    }

    // --------------------------------------------------------------------------
    // `deletion_verifications` Collection Rules (Authenticated Verification Requests)
    // --------------------------------------------------------------------------
    match /deletion_verifications/{refId} {
      // Only document owner can fetch their own verification reference by ID (no listing allowed)
      allow get: if isOwner(resource.data.userId);

      // Allow authenticated owner to create a verification reference matching exact schema and valid timestamp bounds
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAll(['userId', 'referenceId', 'createdAt', 'expiresAt', 'status'])
                    && request.resource.data.keys().hasOnly(['userId', 'referenceId', 'createdAt', 'expiresAt', 'status'])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.referenceId == refId
                    && refId.matches('^REF-[0-9A-F]{32}$')
                    && refId.size() == 36
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.createdAt <= request.time
                    && request.resource.data.createdAt >= request.time - duration.value(5, 'm')
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.resource.data.createdAt
                    && request.resource.data.expiresAt <= request.resource.data.createdAt + duration.value(24, 'h')
                    && request.resource.data.status == 'pending';

      // Disallow client listing, updates, and deletions (only backend Admin SDK can process/delete)
      allow list, update, delete: if false;
    }

    // --------------------------------------------------------------------------
    // Default Catch-All Rule: Deny access to unsupported collections
    // --------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
